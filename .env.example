# BrainFlow / EEG analysis service (the standalone brainflow-service repository).
# Production builds: the public HTTPS URL of the Render service; Vite bakes it
# into the build, so redeploy after changing it. The tracked .env already holds it.
# Local development: `npm run dev` uses an override from .env.local if set, else
# a healthy local brainflow-service on http://127.0.0.1:8000, else this hosted URL.
VITE_BRAINFLOW_SERVICE_URL=https://your-neurasticity-brainflow.onrender.com

# Firebase Production Authentication & Firestore Configuration
# (Obtain these from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set only for an intentionally isolated sample/demo deployment.
# Leave unset in production. Local development enables the sample workspace automatically.
# VITE_DEPLOYMENT_MODE=demo
